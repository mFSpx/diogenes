import json
import sys
import urllib.error
import urllib.parse
import urllib.request

base_url = sys.argv[1].rstrip("/")
json_out = sys.argv[2] == "1"
query = urllib.parse.urlencode(
    {
        "select": "dialogue_id,event_id,response_id,response_body,response_body_sha256,response_delivery_status,response_queued_at,processed_status",
        "order": "response_queued_at.desc",
        "limit": "1",
    },
    safe=",.",
)
url = f"{base_url}/indy_responses?{query}"
try:
    with urllib.request.urlopen(url, timeout=5) as resp:
        rows = json.loads(resp.read().decode("utf-8") or "[]")
except urllib.error.HTTPError as exc:
    body = exc.read().decode("utf-8", "replace")[:400]
    print(f"INDY_RESPONSE_API_UNAVAILABLE={url} status={exc.code} body={body}", file=sys.stderr)
    raise SystemExit(2)
except Exception as exc:
    print(f"INDY_RESPONSE_API_UNAVAILABLE={url} error={type(exc).__name__}:{exc}", file=sys.stderr)
    raise SystemExit(2)

if not rows:
    if json_out:
        print(json.dumps({"ok": True, "status": "NO_INDY_RESPONSE", "source_url": url}, sort_keys=True))
    else:
        print("INDY_RESPONSE_NONE")
    raise SystemExit(0)

row = rows[0]
if json_out:
    print(json.dumps({"ok": True, "status": "FOUND", "source_url": url, "response": row}, sort_keys=True, ensure_ascii=False))
else:
    print(f"RESPONSE_ID={row.get('response_id') or ''}")
    print(f"DIALOGUE_ID={row.get('dialogue_id') or ''}")
    print(f"EVENT_ID={row.get('event_id') or ''}")
    print(f"STATUS={row.get('response_delivery_status') or ''}")
    print(f"QUEUED_AT={row.get('response_queued_at') or ''}")
    print(f"BODY_SHA256={row.get('response_body_sha256') or ''}")
    print("BODY=" + str(row.get("response_body") or ""))
PY
