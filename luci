if [[ "$joined_norm" == "what commands exist?" || "$joined_norm" == "how do i run this?" ]]; then
  exec "$PY" "$ROOT/scripts/luci_help_manual.py" help
fi

case "$1" in
  help|/help|commands|what-commands)
    shift
    exec "$PY" "$ROOT/scripts/luci_help_manual.py" help "$@"
    ;;
  doctor|/doctor)
    shift
    exec "$PY" "$ROOT/scripts/luci_doctor.py" "$@"
    ;;
  check-reality|/check-reality)
    shift
    exec "$PY" "$ROOT/scripts/luci_check_reality.py" "$@"
    ;;
  status|/status)
    shift
    exec "$PY" "$ROOT/scripts/luci_status.py" "$@"
    ;;
  manual|/manual)
    shift
    if [[ "${1:-}" == "current" ]]; then
      shift
    fi
    if [[ "${1:-}" == "capsule" ]]; then
      shift
      exec "$0" root-law-docs "$@"
    fi
    exec "$PY" "$ROOT/scripts/luci_help_manual.py" manual "$@"
    ;;
  active|active-goal|active_goal)
    shift
    if [[ "${1:-}" == "goal" ]]; then
      shift
    fi
    base_url="${POSTGREST_BASE_URL:-http://127.0.0.1:3000}"
    json_out=0
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --base-url)
          base_url="${2:-}"; shift 2;;
        --base-url=*)
          base_url="${1#*=}"; shift;;
        --json)
          json_out=1; shift;;
        *)
          echo "LUCI active goal supports: [--json] [--base-url URL]" >&2
          exit 2;;
      esac
    done
    exec "$PY" - "$base_url" "$json_out" <<'PY'
import json
import sys
import urllib.error
import urllib.parse
import urllib.request

base_url = sys.argv[1].rstrip("/")
json_out = sys.argv[2] == "1"

def fetch(path: str, query: dict[str, str] | None = None):
    qs = urllib.parse.urlencode(query or {}, safe=",.")
    url = f"{base_url}/{path.lstrip('/')}" + (f"?{qs}" if qs else "")
    try:
        with urllib.request.urlopen(url, timeout=5) as resp:
            return url, json.loads(resp.read().decode("utf-8") or "null"), None
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", "replace")[:400]
        return url, None, f"HTTPError:{exc.code}:{body}"
    except Exception as exc:
        return url, None, f"{type(exc).__name__}:{exc}"

openapi_url, openapi, openapi_error = fetch("")
paths = sorted((openapi or {}).get("paths", {}).keys()) if isinstance(openapi, dict) else []
route_present = "/active_goal" in paths
route_url = f"{base_url}/active_goal"
if route_present:
    route_url, rows, route_error = fetch("active_goal", {"limit": "1"})
    if route_error:
        print(f"ACTIVE_GOAL_UNAVAILABLE={route_url} error={route_error}", file=sys.stderr)
        raise SystemExit(2)
    if json_out:
        print(json.dumps({"ok": True, "status": "FOUND", "source_url": route_url, "rows": rows}, sort_keys=True, ensure_ascii=False))
        raise SystemExit(0)
    else:
        first = rows[0] if isinstance(rows, list) and rows else {}
        print(f"ROUTE=/active_goal")
        print(f"URL={route_url}")
        print(f"ROW_COUNT={len(rows) if isinstance(rows, list) else 0}")
        if isinstance(first, dict) and first:
            print(f"TITLE={first.get('title') or first.get('goal_id') or first.get('route_id') or ''}")
            print(f"STATUS={first.get('status') or first.get('route_status') or ''}")
        else:
            print("TITLE=")
            print("STATUS=")
        raise SystemExit(0)

if json_out:
    print(json.dumps({"ok": False, "status": "ROUTE_NOT_LIVE", "source_url": route_url, "openapi_url": openapi_url, "openapi_error": openapi_error}, sort_keys=True, ensure_ascii=False))
else:
    print("ACTIVE_GOAL_ROUTE_NOT_LIVE")
    print(f"OPENAPI={openapi_url}")
    if openapi_error:
        print(f"OPENAPI_ERROR={openapi_error}")
    print(f"ROUTE={route_url}")
PY
    ;;
  todo|/todo)
    shift
    exec "$PY" "$ROOT/scripts/luci_todo.py" "$@"
    ;;
  todo-current|todo/current)
    shift
    if [[ "${1:-}" == "current" ]]; then
      shift
    fi
    exec "$PY" "$ROOT/scripts/luci_todo.py" current "$@"
    ;;
  root-orchestrator|/root-orchestrator|root-orchestrator-current)
