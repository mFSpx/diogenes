if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if [[ $# -eq 0 ]]; then
  if [[ -t 0 ]]; then
    echo "Indy_READs: LUCI online — co-operators ready, PromptFlow sidecar armed, receipts on deck." >&2
    read -r -p "luci> " stdin_text || true
  if [[ -z "${stdin_text//[[:space:]]/}" ]]; then
      usage
      exit 0
    fi
    stdin_norm="$(printf '%s' "$stdin_text" | tr '[:upper:]' '[:lower:]' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
    if [[ "$stdin_norm" == "/help" || "$stdin_norm" == "help" || "$stdin_norm" == "what commands exist?" || "$stdin_norm" == "how do i run this?" ]]; then
      exec "$PY" "$ROOT/scripts/luci_help_manual.py" help
    fi
    if [[ "$stdin_norm" == "/manual" || "$stdin_norm" == "manual" ]]; then
      exec "$PY" "$ROOT/scripts/luci_help_manual.py" manual
    fi
    if [[ "$stdin_norm" == "/todo" || "$stdin_norm" == "todo" ]]; then
      exec "$PY" "$ROOT/scripts/luci_todo.py"
    fi
    if [[ "$stdin_norm" == "/root-orchestrator" || "$stdin_norm" == "root-orchestrator" ]]; then
      exec "$PY" "$ROOT/scripts/luci_help_manual.py" help
    fi
    if [[ "${stdin_text//[[:space:]]/}" == "/flow" ]]; then
      exec "$PY" "$ROOT/07_SURFACES/sidecars/promptflow_canvas.py"
    fi
  else
    stdin_text="$(cat)"
    if [[ -z "${stdin_text//[[:space:]]/}" ]]; then
      usage
      exit 0
    fi
    stdin_norm="$(printf '%s' "$stdin_text" | tr '[:upper:]' '[:lower:]' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
    if [[ "$stdin_norm" == "/help" || "$stdin_norm" == "help" || "$stdin_norm" == "what commands exist?" || "$stdin_norm" == "how do i run this?" ]]; then
      exec "$PY" "$ROOT/scripts/luci_help_manual.py" help
    fi
    if [[ "$stdin_norm" == "/manual" || "$stdin_norm" == "manual" ]]; then
      exec "$PY" "$ROOT/scripts/luci_help_manual.py" manual
    fi
    if [[ "$stdin_norm" == "/todo" || "$stdin_norm" == "todo" ]]; then
      exec "$PY" "$ROOT/scripts/luci_todo.py"
    fi
    if [[ "$stdin_norm" == "/root-orchestrator" || "$stdin_norm" == "root-orchestrator" ]]; then
      exec "$PY" "$ROOT/scripts/luci_help_manual.py" help
    fi
    if [[ "${stdin_text//[[:space:]]/}" == "/flow" ]]; then
      exec "$PY" "$ROOT/07_SURFACES/sidecars/promptflow_canvas.py"
    fi
  fi
  run_luci_engine attempt --text "$stdin_text"
fi

