    base_url="${POSTGREST_BASE_URL:-http://127.0.0.1:3000}"
    json_out=0
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --base-url)
          base_url="${2:-}"; shift 2;;
        --base-url=*)
          base_url="${1#*=}"; shift;;
        --json)
